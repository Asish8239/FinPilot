# FinPilot Backend Environment Variables
# Copy this to .env and fill in your values.
# FinPilot is an ANONYMOUS application — no auth-specific vars required.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-min-32-chars

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get your free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# ── Alpha Vantage Market Data ─────────────────────────────────────────────────
# Get your free API key at https://www.alphavantage.co
# Free tier: 5 calls/min, 500 calls/day (in-memory cache reduces calls)
ALPHA_VANTAGE_API_KEY=

# ── Supabase (DB connection only — auth is NOT used) ─────────────────────────
# These are only needed if using Supabase-specific features beyond the DB URL.
# For basic PostgreSQL usage, only DATABASE_URL is required.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Redis is NOT required — in-memory caching is used instead.
# REDIS_URL=redis://localhost:6379
