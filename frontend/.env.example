# FinPilot Frontend Environment Variables
# Copy this to .env.local and fill in your values.

# ── API Configuration ────────────────────────────────────────────────────────
# Backend API URL - Replit will provide the correct backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Groq AI (optional - for AI Tutor feature) ────────────────────────────────
# Get your free API key at https://console.groq.com
# GROQ_API_KEY is used server-side only; this is for client-side fallback if needed
# GROQ_API_KEY=your_groq_api_key_here

# ── Alpha Vantage (optional - for live market data) ──────────────────────────
# Get your free API key at https://www.alphavantage.co
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
